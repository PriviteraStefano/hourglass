{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "es5",
  "ignorePatterns": [
    "dist",
    "node_modules",
    "src/routeTree.gen.ts",
    "test-results",
    "e2e"
  ]
}
