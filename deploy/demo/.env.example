# Cloudflare Zero Trust → Networks → Tunnels → hourglass-demo → copy token
TUNNEL_TOKEN=eyJhIjoi...

# Required in production/staging (app FATAL-exits if unset when GO_ENV=production)
JWT_SECRET=generate-a-long-random-string

POSTGRES_USER=hourglass
# Changing this after the first `docker compose up -d` does NOT change the stored
# password (pgdata volume keeps the original). Run `docker compose run --rm recover-db`
# to realign.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
POSTGRES_DB=hourglass_demo
